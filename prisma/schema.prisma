generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlanType {
  short_term
  swing
  mid_term
}

enum TradingPlanStatus {
  draft
  active
  triggered
  cancelled
  invalidated
  completed
  expired
}

enum PlanSignal {
  buy
  wait
  hold
  reduce
  avoid
}

enum PlanEventType {
  created
  activated
  entry_zone_touched
  chase_limit_exceeded
  stop_loss_broken
  first_target_reached
  second_target_reached
  signal_changed
  data_became_stale
  data_unavailable
  cancelled
  invalidated
  completed
  manual_note
}

enum ReviewOutcome {
  not_triggered
  cancelled
  stopped_out
  first_target
  second_target
  manual_exit
  expired
  open
}

enum PaperTradeStatus {
  open
  take_profit
  stop_loss
  expired
  manual_closed
}

model TradingPlan {
  id                       String            @id @default(cuid())
  idempotencyKey           String            @unique
  planDate                 String
  code                     String
  name                     String
  sector                   String
  planType                 PlanType
  status                   TradingPlanStatus
  originalSignal           PlanSignal
  finalSignal              PlanSignal
  shortTermScore           Int
  midTermScore             Int
  totalScore               Int
  firstEntryLow            Float
  firstEntryHigh           Float
  secondEntryLow           Float
  secondEntryHigh          Float
  chaseLimit               Float
  stopLoss                 Float
  firstTarget              Float
  secondTarget             Float
  riskRewardRatio          Float
  suggestedPositionPercent Float
  thesis                   String
  reasons                  String
  warnings                 String
  invalidReason            String?
  marketDataMode           String
  marketDataSource         String
  marketTimestamp          DateTime
  calculatedAt             DateTime
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  archivedAt               DateTime?
  isDemo                   Boolean           @default(true)
  events                   PlanEvent[]
  review                   PlanReview?
  snapshot                 SignalSnapshot?

  @@unique([planDate, code, planType, status])
  @@index([code, planDate])
  @@index([status])
  @@index([marketDataMode])
}

model PlanEvent {
  id            String        @id @default(cuid())
  tradingPlanId String
  eventType     PlanEventType
  eventTime     DateTime
  price         Float?
  description   String
  source        String
  metadata      String
  createdAt     DateTime      @default(now())
  tradingPlan   TradingPlan   @relation(fields: [tradingPlanId], references: [id], onDelete: Cascade)

  @@index([tradingPlanId, eventTime])
}

model PlanReview {
  id                               String        @id @default(cuid())
  tradingPlanId                    String        @unique
  reviewDate                       String
  outcome                          ReviewOutcome
  entryPrice                       Float?
  exitPrice                        Float?
  highestPrice                     Float?
  lowestPrice                      Float?
  returnPercent                    Float
  maxFavorableExcursionPercent     Float
  maxAdverseExcursionPercent       Float
  holdingDays                      Int
  followedPlan                     Boolean
  executionNotes                   String
  whatWorked                       String
  whatFailed                       String
  lesson                           String
  createdAt                        DateTime      @default(now())
  updatedAt                        DateTime      @updatedAt
  isDemo                           Boolean       @default(true)
  tradingPlan                      TradingPlan   @relation(fields: [tradingPlanId], references: [id], onDelete: Cascade)
}

model SignalSnapshot {
  id              String      @id @default(cuid())
  tradingPlanId   String      @unique
  snapshotTime    DateTime
  quoteJson       String
  indicatorsJson  String
  shortScoreJson  String
  midScoreJson    String
  tradeLevelsJson String
  dataStatus      String
  dataSource      String
  isDemo          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  tradingPlan     TradingPlan @relation(fields: [tradingPlanId], references: [id], onDelete: Cascade)
}

model DailyMarketBar {
  id              String   @id @default(cuid())
  code            String
  tradingDate     String
  open            Float
  high            Float
  low             Float
  close           Float
  previousClose   Float
  volume          Float
  amount          Float
  turnoverRate    Float
  adjustment      String
  source          String
  fetchedAt       DateTime
  marketTimestamp DateTime?
  dataStatus      String
  checksum        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([code, tradingDate, adjustment, source])
  @@index([code, tradingDate])
  @@index([dataStatus])
}

model MinuteMarketBar {
  id           String   @id @default(cuid())
  code         String
  tradingDate  String
  timestamp    DateTime
  period       String
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Float
  amount       Float
  averagePrice Float
  source       String
  fetchedAt    DateTime
  dataStatus   String
  checksum     String
  createdAt    DateTime @default(now())

  @@unique([code, timestamp, period, source])
  @@index([code, tradingDate, period])
  @@index([dataStatus])
}

model StockQuoteSnapshot {
  id              String   @id @default(cuid())
  code            String
  tradingDate     String
  marketTimestamp DateTime
  price           Float
  previousClose   Float
  open            Float
  high            Float
  low             Float
  change          Float
  changePercent   Float
  volume          Float
  amount          Float
  turnoverRate    Float
  volumeRatio     Float
  source          String
  strategyUsed    String?
  dataStatus      String
  fetchedAt       DateTime
  createdAt       DateTime @default(now())

  @@index([code, tradingDate])
  @@index([code, marketTimestamp])
  @@index([dataStatus])
}

model SectorDailySnapshot {
  id                String   @id @default(cuid())
  sectorId          String
  sectorName        String
  tradingDate       String
  changePercent     Float
  advancingCount    Int
  decliningCount    Int
  unchangedCount    Int
  limitUpCount      Int
  totalAmount       Float
  strengthScore     Float
  leadingStocksJson String
  source            String
  fetchedAt         DateTime
  dataStatus        String
  createdAt         DateTime @default(now())

  @@unique([sectorId, tradingDate, source])
  @@index([tradingDate])
  @@index([dataStatus])
}

model MarketOverviewSnapshot {
  id              String   @id @default(cuid())
  tradingDate     String
  marketTimestamp DateTime
  totalAmount     Float
  advancingCount  Int
  decliningCount  Int
  unchangedCount  Int
  limitUpCount    Int
  limitDownCount  Int
  marketScore     Float
  source          String
  fetchedAt       DateTime
  dataStatus      String
  createdAt       DateTime @default(now())

  @@unique([tradingDate, source])
  @@index([dataStatus])
}

model DataFetchRun {
  id                 String    @id @default(cuid())
  dataType           String
  requestedCodesJson String
  provider           String
  strategyUsed       String?
  startedAt          DateTime
  completedAt        DateTime?
  success            Boolean
  recordCount        Int
  missingCodesJson   String
  errorCode          String?
  durationMs         Int
  usedStaleCache     Boolean
  createdAt          DateTime  @default(now())

  @@index([dataType, createdAt])
  @@index([success])
}

model PaperTrade {
  id                   String           @id @default(cuid())
  code                 String
  name                 String
  sector               String
  entryPrice           Float
  entryTime            DateTime
  entryTradingDate     String
  takeProfitPrice      Float
  stopLossPrice        Float
  status               PaperTradeStatus @default(open)
  exitPrice            Float?
  exitTime             DateTime?
  returnPercent        Float?
  settlementReason     String?
  openKey              String?          @unique
  marketDataSource     String
  marketTimestamp      DateTime
  isDemo               Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([code, status])
  @@index([status, entryTime])
}

enum PaperAccountStatus {
  active
  suspended
  closed
}

enum PaperOrderSide {
  buy
  sell
}

enum PaperOrderStatus {
  pending_confirmation
  confirmed
  rejected
  partially_filled
  filled
  cancelled
  failed
}

enum CashLedgerDirection {
  credit
  debit
}

enum CashLedgerType {
  initial_cash
  cash_adjustment
  buy_settlement
  sell_settlement
  fee
  realized_pnl
}

enum PaperWorkerStatus {
  idle
  running
  paused
  degraded
}

model PaperAccount {
  id                String             @id @default(cuid())
  accountKey        String             @unique
  initialCashFen    BigInt
  availableCashFen  BigInt
  frozenCashFen     BigInt
  realizedPnlFen    BigInt
  cumulativeFeesFen BigInt
  accountVersion    Int                @default(1)
  status            PaperAccountStatus @default(active)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  settingsVersions  PaperAccountSettingsVersion[]
  positions         PaperPosition[]
  orders            PaperOrder[]
  cashLedgerEntries CashLedgerEntry[]
  auditLogs         PaperAuditLog[]
  workerStates      PaperWorkerState[]

  @@index([status, createdAt])
}

model PaperAccountSettingsVersion {
  id                           String   @id @default(cuid())
  scopeKey                     String
  accountId                    String?
  version                      Int
  initialCashForNewAccountsFen BigInt?
  commissionRatePpm            Int
  minimumCommissionFen         BigInt
  stampDutySellRatePpm         Int
  transferFeeRatePpm           Int
  maxSingleStockBp             Int
  maxTotalPositionBp           Int
  maxRiskBp                    Int
  actorId                      String
  idempotencyKey               String?  @unique
  createdAt                    DateTime @default(now())

  account PaperAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, version])
  @@index([accountId, version])
  @@index([createdAt])
}

model PaperPosition {
  id               String   @id @default(cuid())
  accountId        String
  code             String
  totalQuantity    Int
  sellableQuantity Int
  frozenQuantity   Int
  averageCostFen   BigInt
  realizedPnlFen   BigInt
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lots      PaperLot[]
  orders    PaperOrder[]
  exitRules ExitRule[]

  @@unique([accountId, code])
  @@index([accountId, updatedAt])
  @@index([code])
}

model PaperLot {
  id                  String   @id @default(cuid())
  positionId          String
  acquiredSequence    Int
  acquiredTradingDate String
  sellableTradingDate String
  originalQuantity    Int
  remainingQuantity   Int
  priceFen            BigInt
  buyFeeFen           BigInt
  createdAt           DateTime @default(now())

  position PaperPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@unique([positionId, acquiredSequence])
  @@index([positionId, sellableTradingDate])
  @@index([sellableTradingDate])
}

model PaperOrder {
  id               String           @id @default(cuid())
  accountId        String
  positionId       String?
  code             String
  side             PaperOrderSide
  quantity         Int
  priceFen         BigInt?
  status           PaperOrderStatus
  riskSnapshotJson String
  settingsVersion  Int
  idempotencyKey   String?          @unique
  version          Int              @default(1)
  confirmedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  account           PaperAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  position          PaperPosition?    @relation(fields: [positionId], references: [id], onDelete: Restrict)
  fills             PaperFill[]
  cashLedgerEntries CashLedgerEntry[] @relation("PaperOrderCashLedgerEntries")

  @@index([accountId, status, createdAt])
  @@index([positionId, createdAt])
  @@index([code, status])
}

model PaperFill {
  id             String   @id @default(cuid())
  orderId        String
  sequence       Int
  quantity       Int
  priceFen       BigInt
  notionalFen    BigInt
  commissionFen  BigInt
  stampDutyFen   BigInt
  transferFeeFen BigInt
  tradingDate    String
  executedAt     DateTime
  createdAt      DateTime @default(now())

  order PaperOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, sequence])
  @@index([tradingDate, executedAt])
  @@index([executedAt])
}

model CashLedgerEntry {
  id              String              @id @default(cuid())
  accountId       String
  orderId         String?
  sequence        Int
  direction       CashLedgerDirection
  type            CashLedgerType
  amountFen       BigInt
  balanceAfterFen BigInt
  idempotencyKey  String?             @unique
  metadataJson    String?
  occurredAt      DateTime
  createdAt       DateTime            @default(now())

  account PaperAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order   PaperOrder?  @relation("PaperOrderCashLedgerEntries", fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([accountId, sequence])
  @@index([accountId, occurredAt])
  @@index([orderId])
}

model ExitRule {
  id                     String    @id @default(cuid())
  positionId             String
  version                Int
  settingsVersion        Int
  firstTargetPriceFen    BigInt
  secondTargetPriceFen   BigInt
  stopPriceFen           BigInt
  firstTargetExecutedAt  DateTime?
  secondTargetExecutedAt DateTime?
  isActive               Boolean   @default(true)
  actorId                String
  idempotencyKey         String?   @unique
  confirmedAt            DateTime
  supersededAt           DateTime?
  createdAt              DateTime  @default(now())

  position PaperPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@unique([positionId, version])
  @@index([positionId, isActive])
}

model PaperAuditLog {
  id             String   @id @default(cuid())
  accountId      String
  sequence       Int
  action         String
  actorId        String
  entityType     String
  entityId       String?
  payloadJson    String
  idempotencyKey String?  @unique
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  account PaperAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, sequence])
  @@index([accountId, occurredAt])
  @@index([entityType, entityId])
}

model PaperWorkerState {
  id                    String            @id @default(cuid())
  accountId             String
  code                  String
  status                PaperWorkerStatus @default(idle)
  lastProcessedMinuteAt DateTime?
  lastSuccessfulCheckAt DateTime?
  lastErrorCode         String?
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  account PaperAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, code])
  @@index([status, lastSuccessfulCheckAt])
}

model WorkerLease {
  id          String   @id @default(cuid())
  leaseKey    String   @unique
  ownerId     String
  acquiredAt  DateTime
  heartbeatAt DateTime
  expiresAt   DateTime
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}
