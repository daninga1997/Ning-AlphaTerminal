generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlanType {
  short_term
  swing
  mid_term
}

enum TradingPlanStatus {
  draft
  active
  triggered
  cancelled
  invalidated
  completed
  expired
}

enum PlanSignal {
  buy
  wait
  hold
  reduce
  avoid
}

enum PlanEventType {
  created
  activated
  entry_zone_touched
  chase_limit_exceeded
  stop_loss_broken
  first_target_reached
  second_target_reached
  signal_changed
  data_became_stale
  data_unavailable
  cancelled
  invalidated
  completed
  manual_note
}

enum ReviewOutcome {
  not_triggered
  cancelled
  stopped_out
  first_target
  second_target
  manual_exit
  expired
  open
}

model TradingPlan {
  id                       String            @id @default(cuid())
  idempotencyKey           String            @unique
  planDate                 String
  code                     String
  name                     String
  sector                   String
  planType                 PlanType
  status                   TradingPlanStatus
  originalSignal           PlanSignal
  finalSignal              PlanSignal
  shortTermScore           Int
  midTermScore             Int
  totalScore               Int
  firstEntryLow            Float
  firstEntryHigh           Float
  secondEntryLow           Float
  secondEntryHigh          Float
  chaseLimit               Float
  stopLoss                 Float
  firstTarget              Float
  secondTarget             Float
  riskRewardRatio          Float
  suggestedPositionPercent Float
  thesis                   String
  reasons                  String
  warnings                 String
  invalidReason            String?
  marketDataMode           String
  marketDataSource         String
  marketTimestamp          DateTime
  calculatedAt             DateTime
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  archivedAt               DateTime?
  isDemo                   Boolean           @default(true)
  events                   PlanEvent[]
  review                   PlanReview?
  snapshot                 SignalSnapshot?

  @@unique([planDate, code, planType, status])
  @@index([code, planDate])
  @@index([status])
  @@index([marketDataMode])
}

model PlanEvent {
  id            String        @id @default(cuid())
  tradingPlanId String
  eventType     PlanEventType
  eventTime     DateTime
  price         Float?
  description   String
  source        String
  metadata      String
  createdAt     DateTime      @default(now())
  tradingPlan   TradingPlan   @relation(fields: [tradingPlanId], references: [id], onDelete: Cascade)

  @@index([tradingPlanId, eventTime])
}

model PlanReview {
  id                               String        @id @default(cuid())
  tradingPlanId                    String        @unique
  reviewDate                       String
  outcome                          ReviewOutcome
  entryPrice                       Float?
  exitPrice                        Float?
  highestPrice                     Float?
  lowestPrice                      Float?
  returnPercent                    Float
  maxFavorableExcursionPercent     Float
  maxAdverseExcursionPercent       Float
  holdingDays                      Int
  followedPlan                     Boolean
  executionNotes                   String
  whatWorked                       String
  whatFailed                       String
  lesson                           String
  createdAt                        DateTime      @default(now())
  updatedAt                        DateTime      @updatedAt
  isDemo                           Boolean       @default(true)
  tradingPlan                      TradingPlan   @relation(fields: [tradingPlanId], references: [id], onDelete: Cascade)
}

model SignalSnapshot {
  id              String      @id @default(cuid())
  tradingPlanId   String      @unique
  snapshotTime    DateTime
  quoteJson       String
  indicatorsJson  String
  shortScoreJson  String
  midScoreJson    String
  tradeLevelsJson String
  dataStatus      String
  dataSource      String
  isDemo          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  tradingPlan     TradingPlan @relation(fields: [tradingPlanId], references: [id], onDelete: Cascade)
}

model DailyMarketBar {
  id              String   @id @default(cuid())
  code            String
  tradingDate     String
  open            Float
  high            Float
  low             Float
  close           Float
  previousClose   Float
  volume          Float
  amount          Float
  turnoverRate    Float
  adjustment      String
  source          String
  fetchedAt       DateTime
  marketTimestamp DateTime?
  dataStatus      String
  checksum        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([code, tradingDate, adjustment, source])
  @@index([code, tradingDate])
  @@index([dataStatus])
}

model MinuteMarketBar {
  id           String   @id @default(cuid())
  code         String
  tradingDate  String
  timestamp    DateTime
  period       String
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Float
  amount       Float
  averagePrice Float
  source       String
  fetchedAt    DateTime
  dataStatus   String
  checksum     String
  createdAt    DateTime @default(now())

  @@unique([code, timestamp, period, source])
  @@index([code, tradingDate, period])
  @@index([dataStatus])
}

model StockQuoteSnapshot {
  id              String   @id @default(cuid())
  code            String
  tradingDate     String
  marketTimestamp DateTime
  price           Float
  previousClose   Float
  open            Float
  high            Float
  low             Float
  change          Float
  changePercent   Float
  volume          Float
  amount          Float
  turnoverRate    Float
  volumeRatio     Float
  source          String
  strategyUsed    String?
  dataStatus      String
  fetchedAt       DateTime
  createdAt       DateTime @default(now())

  @@index([code, tradingDate])
  @@index([code, marketTimestamp])
  @@index([dataStatus])
}

model SectorDailySnapshot {
  id                String   @id @default(cuid())
  sectorId          String
  sectorName        String
  tradingDate       String
  changePercent     Float
  advancingCount    Int
  decliningCount    Int
  unchangedCount    Int
  limitUpCount      Int
  totalAmount       Float
  strengthScore     Float
  leadingStocksJson String
  source            String
  fetchedAt         DateTime
  dataStatus        String
  createdAt         DateTime @default(now())

  @@unique([sectorId, tradingDate, source])
  @@index([tradingDate])
  @@index([dataStatus])
}

model MarketOverviewSnapshot {
  id              String   @id @default(cuid())
  tradingDate     String
  marketTimestamp DateTime
  totalAmount     Float
  advancingCount  Int
  decliningCount  Int
  unchangedCount  Int
  limitUpCount    Int
  limitDownCount  Int
  marketScore     Float
  source          String
  fetchedAt       DateTime
  dataStatus      String
  createdAt       DateTime @default(now())

  @@unique([tradingDate, source])
  @@index([dataStatus])
}

model DynamicWatchlistEntry {
  id                  String   @id @default(cuid())
  stockCode           String   @map("stock_code")
  stockName           String   @map("stock_name")
  sourceType          String   @default("DYNAMIC") @map("source_type")
  firstAddedAt        DateTime @default(now()) @map("first_added_at")
  lastAnalyzedAt      DateTime @default(now()) @map("last_analyzed_at")
  triggerStrategy     String   @map("trigger_strategy")
  lastStrategyAction  String   @map("last_strategy_action")
  dataIntegrityStatus String   @default("READY") @map("data_integrity_status")
  latestConclusion    String?  @map("latest_conclusion")
  signalValidUntil    DateTime @map("signal_valid_until")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([stockCode, sourceType])
  @@map("dynamic_watchlist")
}

model DataFetchRun {
  id                 String    @id @default(cuid())
  dataType           String
  requestedCodesJson String
  provider           String
  strategyUsed       String?
  startedAt          DateTime
  completedAt        DateTime?
  success            Boolean
  recordCount        Int
  missingCodesJson   String
  errorCode          String?
  durationMs         Int
  usedStaleCache     Boolean
  createdAt          DateTime  @default(now())

  @@index([dataType, createdAt])
  @@index([success])
}
