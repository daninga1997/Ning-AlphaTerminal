{
  "name": "astock-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init_trading_memory",
    "prisma:seed": "prisma db seed",
    "akshare:service": "powershell -ExecutionPolicy Bypass -File scripts/start-akshare-service.ps1",
    "akshare:check": "powershell -ExecutionPolicy Bypass -File scripts/check-akshare-service.ps1",
    "dev:akshare": "powershell -ExecutionPolicy Bypass -File scripts/start-alpha-dev.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "16.2.10",
    "prisma": "^6.16.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
